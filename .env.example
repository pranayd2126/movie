# Copy to .env.local. Server-only secrets; never commit a filled env file.
# Real TMDB data is the only normal application source.
DATA_MODE=tmdb
APP_STAGE=local
APP_ORIGIN=http://localhost:5000
DEFAULT_REGION=IN

# TMDB Settings > API > API Read Access Token (preferred).
TMDB_READ_ACCESS_TOKEN=
# Optional alternative: TMDB v3 API key. Not needed when the read token is set.
TMDB_API_KEY=

# Account persistence connection, server only. Anonymous browsing needs no database.
MONGODB_URI=

# Optional first-party TMDB API hostname; only these two hosts are accepted.
# api.tmdb.org can be used when api.themoviedb.org is unreachable locally.
TMDB_API_HOST=api.themoviedb.org
