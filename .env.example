# Configuration proposal; there is no runnable application yet.
# Copy to .env for local development. Never put secrets in Git or chat.
# No credentials are required for the planned fixture development mode.
DATA_MODE=fixture
APP_ORIGIN=http://localhost:3000
DEFAULT_REGION=IN

# Server only. Obtain a TMDB API Read Access Token, not an OTT password.
# Credentials do not grant commercial rights; confirm the intended use first.
TMDB_READ_ACCESS_TOKEN=

# Enable one licensed availability adapter after coverage/contract validation.
# Planned values: fixture, tmdb, justwatch, watchmode, movieofthenight
AVAILABILITY_VENDOR=fixture
AVAILABILITY_API_KEY=

# Required only when implementing real authentication and persistence.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Privileged backend jobs only; never expose this key to a browser.
SUPABASE_SECRET_KEY=
# Migration/admin connection only, never a browser-side value.
DATABASE_URL=

# Optional scheduled ingestion; populate only when that phase is implemented.
INGESTION_CRON_SECRET=
